CREATE DATABASE sewage_plant WITH DURATION 365d REPLICATION 1 SHARD DURATION 7d NAME one_year;

USE sewage_plant;

CREATE RETENTION POLICY one_month ON sewage_plant DURATION 30d REPLICATION 1;
CREATE RETENTION POLICY one_week ON sewage_plant DURATION 7d REPLICATION 1;

CREATE CONTINUOUS QUERY cq_sensor_1h ON sewage_plant
BEGIN
  SELECT mean(value) AS value, mean(setpoint) AS setpoint
  INTO one_year.sensor_data_1h
  FROM sensor_data
  GROUP BY time(1h), id, type, stage, section
END;

CREATE CONTINUOUS QUERY cq_sensor_5m ON sewage_plant
BEGIN
  SELECT mean(value) AS value, mean(setpoint) AS setpoint
  INTO one_month.sensor_data_5m
  FROM sensor_data
  GROUP BY time(5m), id, type, stage, section
END;

CREATE CONTINUOUS QUERY cq_aeration_1h ON sewage_plant
BEGIN
  SELECT mean(air_flow_set) AS air_flow_set, mean(air_flow_actual) AS air_flow_actual,
         mean(valve_open) AS valve_open, mean(do_actual) AS do_actual, mean(nh3_actual) AS nh3_actual
  INTO one_year.aeration_control_1h
  FROM aeration_control
  GROUP BY time(1h), section
END;

CREATE CONTINUOUS QUERY cq_carbon_1h ON sewage_plant
BEGIN
  SELECT mean(dosing_rate) AS dosing_rate, mean(dosing_actual) AS dosing_actual,
         mean(cod_influent) AS cod_influent, mean(no3_anoxic) AS no3_anoxic,
         mean(tn_removal) AS tn_removal
  INTO one_year.carbon_dosing_1h
  FROM carbon_dosing
  GROUP BY time(1h)
END;

CREATE CONTINUOUS QUERY cq_metrics_1h ON sewage_plant
BEGIN
  SELECT mean(power_consumption) AS power_consumption, mean(carbon_usage) AS carbon_usage,
         mean(tn_removal_rate) AS tn_removal_rate, mean(tp_removal_rate) AS tp_removal_rate,
         mean(cod_removal_rate) AS cod_removal_rate, mean(flow_rate) AS flow_rate
  INTO one_year.key_metrics_1h
  FROM key_metrics
  GROUP BY time(1h)
END;

CREATE CONTINUOUS QUERY cq_metrics_1d ON sewage_plant
BEGIN
  SELECT mean(power_consumption) AS power_consumption, mean(carbon_usage) AS carbon_usage,
         mean(tn_removal_rate) AS tn_removal_rate, mean(tp_removal_rate) AS tp_removal_rate,
         mean(cod_removal_rate) AS cod_removal_rate, mean(flow_rate) AS flow_rate
  INTO one_year.key_metrics_1d
  FROM key_metrics
  GROUP BY time(1d)
END;

CREATE USER admin WITH PASSWORD 'admin123' WITH ALL PRIVILEGES;
