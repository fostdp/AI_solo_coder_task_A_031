-- InfluxDB Initialization Script for Sewage Treatment Plant
-- 创建数据库
CREATE DATABASE sewage WITH DURATION 365d REPLICATION 1;

-- 使用数据库
USE sewage;

-- 创建保留策略
-- 原始数据保留30天
CREATE RETENTION POLICY "raw_data" ON "sewage" DURATION 30d REPLICATION 1 DEFAULT;

-- 分钟级聚合数据保留90天
CREATE RETENTION POLICY "minutely" ON "sewage" DURATION 90d REPLICATION 1;

-- 小时级聚合数据保留365天
CREATE RETENTION POLICY "hourly" ON "sewage" DURATION 365d REPLICATION 1;

-- 天级聚合数据永久保留
CREATE RETENTION POLICY "daily" ON "sewage" DURATION INF REPLICATION 1;

-- 创建连续查询 - 分钟级聚合
CREATE CONTINUOUS QUERY "cq_minutely_sensor" ON "sewage"
BEGIN
  SELECT
    mean("value") AS "value",
    min("value") AS "min_value",
    max("value") AS "max_value"
  INTO "minutely"."sensor_data"
  FROM "raw_data"."sensor_data"
  GROUP BY time(1m), *
END;

CREATE CONTINUOUS QUERY "cq_minutely_control" ON "sewage"
BEGIN
  SELECT
    mean("value") AS "value"
  INTO "minutely"."control_data"
  FROM "raw_data"."control_data"
  GROUP BY time(1m), *
END;

CREATE CONTINUOUS QUERY "cq_minutely_alarm" ON "sewage"
BEGIN
  SELECT
    count("value") AS "count"
  INTO "minutely"."alarm_data"
  FROM "raw_data"."alarm_data"
  GROUP BY time(1m), *
END;

-- 创建连续查询 - 小时级聚合
CREATE CONTINUOUS QUERY "cq_hourly_sensor" ON "sewage"
BEGIN
  SELECT
    mean("value") AS "value",
    min("min_value") AS "min_value",
    max("max_value") AS "max_value"
  INTO "hourly"."sensor_data"
  FROM "minutely"."sensor_data"
  GROUP BY time(1h), *
END;

CREATE CONTINUOUS QUERY "cq_hourly_control" ON "sewage"
BEGIN
  SELECT
    mean("value") AS "value"
  INTO "hourly"."control_data"
  FROM "minutely"."control_data"
  GROUP BY time(1h), *
END;

CREATE CONTINUOUS QUERY "cq_hourly_kpi" ON "sewage"
BEGIN
  SELECT
    mean("value") AS "value"
  INTO "hourly"."kpi_data"
  FROM "raw_data"."kpi_data"
  GROUP BY time(1h), *
END;

-- 创建连续查询 - 天级聚合
CREATE CONTINUOUS QUERY "cq_daily_sensor" ON "sewage"
BEGIN
  SELECT
    mean("value") AS "value",
    min("min_value") AS "min_value",
    max("max_value") AS "max_value"
  INTO "daily"."sensor_data"
  FROM "hourly"."sensor_data"
  GROUP BY time(1d), *
END;

CREATE CONTINUOUS QUERY "cq_daily_kpi" ON "sewage"
BEGIN
  SELECT
    mean("value") AS "value",
    integral("value") / 3600 AS "integral"
  INTO "daily"."kpi_data"
  FROM "hourly"."kpi_data"
  GROUP BY time(1d), *
END;

-- 创建管理员用户
CREATE USER admin WITH PASSWORD 'admin' WITH ALL PRIVILEGES;

-- 创建只读用户
CREATE USER reader WITH PASSWORD 'reader';
GRANT READ ON sewage TO reader;

-- 显示结果
SHOW DATABASES;
SHOW RETENTION POLICIES ON sewage;
SHOW CONTINUOUS QUERIES;
SHOW USERS;
