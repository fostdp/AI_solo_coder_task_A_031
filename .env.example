# ==========================================
# 城市污水处理厂精确曝气系统 - 环境变量配置
# ==========================================

# ==========================================
# Go后端服务配置
# ==========================================
SEWAGE_SERVER_PORT=8080
SEWAGE_SERVER_MODE=release

# ==========================================
# InfluxDB配置
# ==========================================
SEWAGE_INFLUXDB_ADDR=http://influxdb:8086
SEWAGE_INFLUXDB_USERNAME=admin
SEWAGE_INFLUXDB_PASSWORD=admin123
SEWAGE_INFLUXDB_DATABASE=sewage_plant
SEWAGE_INFLUXDB_RETENTION_POLICY=raw_data
SEWAGE_INFLUXDB_TIMEOUT=10s

# ==========================================
# MQTT配置
# ==========================================
SEWAGE_MQTT_BROKER=tcp://emqx:1883
SEWAGE_MQTT_CLIENT_ID=sewage_server
SEWAGE_MQTT_USERNAME=admin
SEWAGE_MQTT_PASSWORD=public

# ==========================================
# WebSocket配置
# ==========================================
SEWAGE_WEBSOCKET_PORT=8081
SEWAGE_WEBSOCKET_PATH=/ws

# ==========================================
# 传感器模拟器配置
# ==========================================
MQTT_BROKER=emqx
MQTT_PORT=1883
MQTT_USERNAME=admin
MQTT_PASSWORD=public
MQTT_QOS=1
REPORT_INTERVAL=120
WATER_QUALITY_FLUCTUATION=1.0
FAULT_SIMULATION_ENABLED=true
DRIFT_SIMULATION_ENABLED=true
SENSORS_PER_DTU=10

# 传感器数量配置 (总计75个)
DO_SENSOR_COUNT=28
NH3_SENSOR_COUNT=18
NO3_SENSOR_COUNT=12
PO4_SENSOR_COUNT=10
COD_SENSOR_COUNT=5
FLOW_SENSOR_COUNT=2

# DO传感器基准值
DO_BASE_ANAEROBIC=0.2
DO_BASE_ANOXIC=0.5
DO_BASE_AEROBIC1=2.5
DO_BASE_AEROBIC2=2.0
DO_BASE_AEROBIC3=1.5
DO_BASE_EFFLUENT=2.0
DO_VARIATION=0.3

# NH3传感器基准值
NH3_BASE_ANAEROBIC=35.0
NH3_BASE_ANOXIC=25.0
NH3_BASE_AEROBIC1=15.0
NH3_BASE_AEROBIC2=5.0
NH3_BASE_AEROBIC3=2.0
NH3_BASE_EFFLUENT=1.5
NH3_VARIATION=2.0

# NO3传感器基准值
NO3_BASE_ANAEROBIC=2.0
NO3_BASE_ANOXIC=8.0
NO3_BASE_AEROBIC1=12.0
NO3_BASE_AEROBIC2=10.0
NO3_BASE_AEROBIC3=8.0
NO3_BASE_EFFLUENT=10.0
NO3_VARIATION=1.5

# PO4传感器基准值
PO4_BASE_ANAEROBIC=6.0
PO4_BASE_ANOXIC=5.0
PO4_BASE_AEROBIC1=3.0
PO4_BASE_AEROBIC2=1.0
PO4_BASE_AEROBIC3=0.5
PO4_BASE_EFFLUENT=0.3
PO4_VARIATION=0.3

# COD传感器基准值
COD_BASE_INFLUENT=350.0
COD_BASE_ANAEROBIC=300.0
COD_BASE_ANOXIC=250.0
COD_BASE_AEROBIC1=150.0
COD_BASE_EFFLUENT=40.0
COD_VARIATION=30.0

# FLOW传感器基准值
FLOW_BASE_INFLUENT=300000.0
FLOW_BASE_EFFLUENT=295000.0
FLOW_VARIATION=15000.0

# ==========================================
# PLC模拟器配置
# ==========================================
STATUS_TOPIC_QOS=1
REPORT_INTERVAL=5
FAULT_SIMULATION_ENABLED=true
RESPONSE_TIME=0.5
CONTROL_TOPIC=control/+/+
STATUS_TOPIC=plc/{plc_id}/status
FEEDBACK_TOPIC=plc/{plc_id}/feedback

# PLC ID配置
PLC_AER_ID=PLC-AER-01
PLC_CARB_ID=PLC-CARB-01
PLC_MIX_ID=PLC-MIX-01
PLC_SLU_ID=PLC-SLU-01

# ==========================================
# InfluxDB初始化配置
# ==========================================
INFLUXDB_DB=sewage_plant
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=admin123
INFLUXDB_USER=writer
INFLUXDB_USER_PASSWORD=writer123
INFLUXDB_READ_USER=reader
INFLUXDB_READ_USER_PASSWORD=reader123

# ==========================================
# EMQX配置
# ==========================================
EMQX_NAME=sewage-emqx
EMQX_HOST=emqx
EMQX_ALLOW_ANONYMOUS=true
EMQX_MQTT__MAX_QOS_ALLOWED=2
EMQX_MQTT__RETRY_INTERVAL=15s
EMQX_MQTT__MAX_INFLIGHT=100
EMQX_MQTT__MQUEUE_MAX_LEN=1000
EMQX_MQTT__QOS1_GUARANTEE=true
EMQX_MQTT__QOS1_MAX_RETRIES=3
EMQX_MQTT__QOS1_ACK_TIMEOUT=30s
EMQX_PERSISTENCE=true

# ==========================================
# 时区配置
# ==========================================
TZ=Asia/Shanghai
