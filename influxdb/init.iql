CREATE DATABASE sewage_plant WITH DURATION 365d REPLICATION 1 SHARD DURATION 7d NAME "autogen"

CREATE RETENTION POLICY "raw_data" ON "sewage_plant" DURATION 30d REPLICATION 1 SHARD DURATION 1d
CREATE RETENTION POLICY "hourly_data" ON "sewage_plant" DURATION 180d REPLICATION 1 SHARD DURATION 7d
CREATE RETENTION POLICY "daily_data" ON "sewage_plant" DURATION 365d REPLICATION 1 SHARD DURATION 30d

CREATE CONTINUOUS QUERY "cq_hourly_sensor" ON "sewage_plant"
BEGIN
  SELECT mean(value) as value, max(value) as max_value, min(value) as min_value, stddev(value) as stddev
  INTO "hourly_data"."sensor_data_hourly"
  FROM "raw_data"."sensor_data"
  GROUP BY time(1h), sensor_id, type, location
END

CREATE CONTINUOUS QUERY "cq_daily_sensor" ON "sewage_plant"
BEGIN
  SELECT mean(value) as value, max(value) as max_value, min(value) as min_value, stddev(value) as stddev, sum(value) as total
  INTO "daily_data"."sensor_data_daily"
  FROM "hourly_data"."sensor_data_hourly"
  GROUP BY time(1d), sensor_id, type, location
END

CREATE CONTINUOUS QUERY "cq_hourly_energy" ON "sewage_plant"
BEGIN
  SELECT mean(value) as value, sum(value) as total, max(value) as peak
  INTO "hourly_data"."energy_data_hourly"
  FROM "raw_data"."energy_data"
  GROUP BY time(1h), type
END

CREATE CONTINUOUS QUERY "cq_daily_energy" ON "sewage_plant"
BEGIN
  SELECT mean(value) as avg_value, sum(value) as total, max(value) as peak
  INTO "daily_data"."energy_data_daily"
  FROM "hourly_data"."energy_data_hourly"
  GROUP BY time(1d), type
END

CREATE CONTINUOUS QUERY "cq_hourly_control" ON "sewage_plant"
BEGIN
  SELECT mean(do_actual) as do_actual, mean(do_setpoint) as do_setpoint,
         mean(nh3_actual) as nh3_actual, mean(nh3_setpoint) as nh3_setpoint,
         mean(airflow_setpoint) as airflow_setpoint, mean(valve_opening) as valve_opening,
         mean(fan_speed) as fan_speed, mean(pid_output) as pid_output,
         mean(feedforward_output) as feedforward_output, mean(total_output) as total_output
  INTO "hourly_data"."aeration_control_hourly"
  FROM "raw_data"."aeration_control"
  GROUP BY time(1h), zone_id
END

CREATE CONTINUOUS QUERY "cq_hourly_carbon" ON "sewage_plant"
BEGIN
  SELECT mean(no3_setpoint) as no3_setpoint, mean(tn_setpoint) as tn_setpoint,
         mean(cod_influent) as cod_influent, mean(cod_required) as cod_required,
         mean(cod_available) as cod_available, mean(tn_influent) as tn_influent,
         mean(tn_effluent) as tn_effluent, mean(tn_removal_rate) as tn_removal_rate,
         mean(dosage_setpoint) as dosage_setpoint
  INTO "hourly_data"."carbon_control_hourly"
  FROM "raw_data"."carbon_control"
  GROUP BY time(1h)
END

CREATE CONTINUOUS QUERY "cq_daily_kpi" ON "sewage_plant"
BEGIN
  SELECT mean(energy_per_ton) as energy_per_ton,
         mean(carbon_per_ton) as carbon_per_ton,
         mean(tn_removal_rate) as tn_removal_rate,
         mean(nh3_removal_rate) as nh3_removal_rate,
         mean(cod_removal_rate) as cod_removal_rate
  INTO "daily_data"."kpi_daily"
  FROM "raw_data"."kpi_data"
  GROUP BY time(1d)
END

CREATE USER "admin" WITH PASSWORD 'admin123' WITH ALL PRIVILEGES
CREATE USER "reader" WITH PASSWORD 'reader123'
GRANT READ ON sewage_plant TO "reader"
CREATE USER "writer" WITH PASSWORD 'writer123'
GRANT WRITE ON sewage_plant TO "writer"

CREATE RETENTION POLICY "one_week" ON "sewage_plant" DURATION 7d REPLICATION 1 SHARD DURATION 1d
CREATE RETENTION POLICY "three_months" ON "sewage_plant" DURATION 90d REPLICATION 1 SHARD DURATION 7d
CREATE RETENTION POLICY "one_year" ON "sewage_plant" DURATION 365d REPLICATION 1 SHARD DURATION 30d

ALTER RETENTION POLICY "raw_data" ON "sewage_plant" DURATION 30d SHARD DURATION 1d DEFAULT
